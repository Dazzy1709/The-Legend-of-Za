# Copy to .env.local and adjust.
#
# Where accounts and saves live:
#   online — on the player's account on the game server (default).
#            `npm run dev` starts the reference server (server/) too.
#   local  — on this device only (browser storage). No server needed.
VITE_BACKEND=online
# Base URL of the game API. In development the dev server proxies /api to
# http://localhost:8787 (see vite.config.ts). In production use your
# HTTPS API, e.g. https://api.example.com/api
VITE_API_URL=/api
