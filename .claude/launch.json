{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "legend-of-za",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "legend-of-za-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "legend-of-za-isolated",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "ZAZA_API_PORT=8797 ZAZA_DATA_DIR=/private/tmp/claude-501/zaza-test-data npm run dev -- --port 5197 --strictPort"
      ],
      "port": 5197
    }
  ]
}
